{
  "name": "play",
  "version": "1.0.0",
  "description": "A few simple browser games for kids.",
  "main": "sw.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "jest",
    "cache-manifest": "node scripts/update-precache.js",
    "check:assets": "python3 scripts/check-assets.py"
  },
  "repository": {
